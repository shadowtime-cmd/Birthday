<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Happy Birthday!</title>
    <style>
        /* ================= BASE STYLES ================= */
        * { box-sizing: border-box; }
        body, html {
            margin: 0;
            padding: 0;
            font-family: 'Segoe UI', system-ui, -apple-system, sans-serif;
            background: linear-gradient(135deg, #0f0c20 0%, #1a103c 50%, #2b0938 100%);
            color: #ffffff;
            overflow-x: hidden;
            min-height: 100vh;
        }

        /* Dynamic Particle Background */
        #particle-container {
            position: fixed;
            top: 0; left: 0;
            width: 100vw; height: 100vh;
            pointer-events: none;
            z-index: 0;
        }
        .particle {
            position: absolute;
            background: rgba(255, 255, 255, 0.7);
            border-radius: 50%;
            box-shadow: 0 0 12px rgba(255, 154, 238, 0.8);
            animation: float 6s infinite ease-in-out alternate;
        }
        @keyframes float {
            0% { transform: translateY(0px) translateX(0px); }
            100% { transform: translateY(-25px) translateX(15px); }
        }

        /* Glassmorphism Cards */
        .card {
            background: rgba(255, 255, 255, 0.07);
            backdrop-filter: blur(16px);
            -webkit-backdrop-filter: blur(16px);
            border: 1px solid rgba(255, 255, 255, 0.18);
            padding: 45px 35px;
            border-radius: 24px;
            max-width: 600px;
            box-shadow: 0 20px 40px rgba(0, 0, 0, 0.4), inset 0 0 20px rgba(255, 255, 255, 0.05);
            text-align: center;
        }
        h1 {
            font-size: 3.2em;
            margin: 0 0 15px 0;
            background: linear-gradient(45deg, #ff9a9e, #fecfef, #a1c4fd);
            -webkit-background-clip: text;
            -webkit-text-fill-color: transparent;
        }
        h2 { font-size: 2.3em; color: #fecfef; margin-0 0 15px 0; }
        p { font-size: 1.2em; line-height: 1.6; color: #e0e0e0; margin-bottom: 20px; }

        /* Buttons */
        .btn {
            background: linear-gradient(45deg, #ff4081, #ff79b0);
            color: white;
            border: none;
            padding: 16px 36px;
            font-size: 1.15em;
            border-radius: 50px;
            cursor: pointer;
            font-weight: 700;
            letter-spacing: 0.5px;
            transition: all 0.3s cubic-bezier(0.175, 0.885, 0.32, 1.275);
            box-shadow: 0 8px 25px rgba(255, 64, 129, 0.4);
            margin: 10px 5px;
            display: inline-block;
        }
        .btn:hover {
            transform: scale(1.06) translateY(-3px);
            box-shadow: 0 12px 30px rgba(255, 64, 129, 0.7);
        }

        /* ================= PAGE 1: GREETINGS ================= */
        #main-page section {
            position: relative;
            z-index: 1;
            height: 100vh;
            display: flex;
            justify-content: center;
            align-items: center;
            padding: 20px;
        }

        /* ================= PAGE 2: GIFTS ================= */
        #gift-page {
            display: none;
            position: relative;
            z-index: 1;
            min-height: 100vh;
            text-align: center;
            padding: 60px 20px;
        }
        .gift-grid {
            display: flex;
            flex-wrap: wrap;
            justify-content: center;
            gap: 25px;
            max-width: 850px;
            margin: 40px auto;
        }
        .gift-box {
            font-size: 3.5em;
            cursor: pointer;
            transition: all 0.3s ease;
            background: rgba(255, 255, 255, 0.08);
            padding: 25px;
            border-radius: 20px;
            border: 1px solid rgba(255, 255, 255, 0.15);
            box-shadow: 0 10px 20px rgba(0,0,0,0.2);
        }
        .gift-box:hover {
            transform: scale(1.12) rotate(6deg);
            background: rgba(255, 255, 255, 0.2);
        }
        .gift-box.opened {
            opacity: 0.4;
            pointer-events: none;
            filter: grayscale(80%);
        }

        /* Modal Popup */
        #note-modal {
            display: none;
            position: fixed;
            top: 50%; left: 50%;
            transform: translate(-50%, -50%);
            background: #ffffff;
            color: #222;
            padding: 35px;
            border-radius: 24px;
            z-index: 100;
            max-width: 420px;
            width: 85%;
            text-align: center;
            box-shadow: 0 25px 60px rgba(0,0,0,0.6);
            animation: popIn 0.3s cubic-bezier(0.175, 0.885, 0.32, 1.275);
        }
        @keyframes popIn {
            0% { transform: translate(-50%, -50%) scale(0.6); opacity: 0; }
            100% { transform: translate(-50%, -50%) scale(1); opacity: 1; }
        }
        .modal-bg {
            display: none;
            position: fixed;
            top: 0; left: 0;
            width: 100vw; height: 100vh;
            background: rgba(0,0,0,0.75);
            backdrop-filter: blur(5px);
            z-index: 99;
        }

        /* ================= PAGE 3: CARTOON CAKE ================= */
        #cake-page {
            display: none;
            position: relative;
            z-index: 1;
            min-height: 100vh;
            text-align: center;
            padding: 40px 20px;
            flex-direction: column;
            align-items: center;
            justify-content: center;
        }

        /* Animated Floating Background Decorations */
        .bg-decorations {
            position: fixed;
            top: 0; left: 0;
            width: 100%; height: 100%;
            pointer-events: none;
            z-index: 0;
        }
        .floating-balloon {
            position: absolute;
            font-size: 3em;
            animation: floatUp 8s infinite linear;
            opacity: 0.7;
        }
        @keyframes floatUp {
            0% { transform: translateY(105vh) rotate(0deg); }
            100% { transform: translateY(-15vh) rotate(360deg); }
        }

        /* Cake Scene Container */
        .cake-wrapper {
            position: relative;
            width: 320px;
            height: 320px;
            margin: 30px auto;
        }

        /* Cute Kitties (Hidden inside cake initially) */
        .kitties-container {
            position: absolute;
            top: 60px;
            left: 50%;
            transform: translateX(-50%) scale(0);
            display: flex;
            gap: 15px;
            z-index: 2;
            transition: all 0.8s cubic-bezier(0.175, 0.885, 0.32, 1.275);
            opacity: 0;
        }
        .kitties-container.pop-out {
            transform: translateX(-50%) scale(1);
            opacity: 1;
            animation: kittyBounce 1.5s infinite ease-in-out alternate;
        }
        @keyframes kittyBounce {
            0% { transform: translateX(-50%) translateY(0) scale(1); }
            100% { transform: translateX(-50%) translateY(-15px) scale(1.05); }
        }
        .kitty-card {
            background: rgba(255, 255, 255, 0.9);
            border-radius: 50px;
            padding: 10px 15px;
            box-shadow: 0 10px 25px rgba(0,0,0,0.3);
            text-align: center;
        }
        .kitty-avatar {
            font-size: 4em;
            display: block;
            line-height: 1;
        }
        .party-cap {
            position: absolute;
            top: -15px;
            font-size: 1.8em;
        }

        /* SVG Cake Elements */
        .svg-cake {
            width: 100%;
            height: 100%;
            position: relative;
            z-index: 3;
            transition: transform 0.6s ease;
        }

        /* Explosion Animations */
        .svg-cake.exploded .cake-top {
            animation: explodeTop 0.8s forwards ease-out;
        }
        .svg-cake.exploded .cake-bottom {
            animation: explodeBottom 0.8s forwards ease-out;
        }
        .svg-cake.exploded .candle-flame {
            display: none;
        }
        @keyframes explodeTop {
            0% { transform: translateY(0) rotate(0deg); opacity: 1; }
            100% { transform: translateY(-140px) rotate(-25deg) scale(0.7); opacity: 0; }
        }
        @keyframes explodeBottom {
            0% { transform: translateY(0) rotate(0deg); opacity: 1; }
            100% { transform: translateY(140px) rotate(25deg) scale(0.7); opacity: 0; }
        }

        /* Candle Flame Flickering Animation */
        .candle-flame {
            animation: flicker 0.6s infinite alternate ease-in-out;
            transform-origin: center bottom;
        }
        @keyframes flicker {
            0% { transform: scale(1) rotate(-3deg); opacity: 0.9; }
            100% { transform: scale(1.2) rotate(3deg); opacity: 1; }
        }

        /* Canvas burst overlay */
        #explosion-canvas {
            position: absolute;
            top: 0; left: 0;
            width: 100%; height: 100%;
            pointer-events: none;
            z-index: 5;
        }
    </style>
</head>
<body>

    <div id="particle-container"></div>

    <div class="bg-decorations" id="bg-decorations"></div>

    <div id="main-page">
        <section>
            <div class="card">
                <h1>🎉 Happy Birthday! 🎉</h1>
                <p>Today is a day to celebrate someone truly special.</p>
                <p style="font-size: 0.9em; color: #aaa; margin-top: 25px;">Scroll Down ↓</p>
            </div>
        </section>

        <section>
            <div class="card">
                <h2>Wishing You The Best</h2>
                <p>May your year ahead be full of endless laughter, dream-chasing, good health, and immaculate vibes!</p>
            </div>
        </section>

        <section>
            <div class="card">
                <h2>Ready for Your Surprises? 🎁</h2>
                <p>Click below to open your birthday gifts and unlock your wishes!</p>
                <button class="btn" onclick="showPage('gift-page')">Open Gifts 🎁</button>
                <button class="btn" style="background: linear-gradient(45deg, #7c4dff, #b388ff);" onclick="showPage('cake-page')">Let's Cut the Cake 🎂</button>
            </div>
        </section>
    </div>

    <div id="gift-page">
        <div class="card" style="margin: 0 auto; max-width: 750px;">
            <h2>Pick a Gift Box! 🎁</h2>
            <p>Click each box to unlock a special birthday wish!</p>
            
            <div class="gift-grid" id="gifts-container"></div>

            <button class="btn" style="background: linear-gradient(45deg, #00e676, #1de9b6); color: #004d40;" onclick="showPage('cake-page')">
                Let's Cut the Cake 🎂 →
            </button>
        </div>
    </div>

    <div class="modal-bg" id="modal-bg"></div>
    <div id="note-modal">
        <h3 style="margin-top: 0; color: #ff4081; font-size: 1.6em;">✉️ Birthday Note</h3>
        <p id="note-text" style="font-size: 1.15em; color: #444; font-weight: 500;"></p>
        <button class="btn" style="padding: 10px 30px; font-size: 1em;" onclick="closeNote()">Awesome! ✨</button>
    </div>

    <div id="cake-page">
        <div class="card" style="max-width: 650px; width: 100%;">
            <h1 id="cake-title">Make a Wish! 🎂</h1>
            <p id="cake-subtitle">Click the button below to cut the cake!</p>

            <div class="cake-wrapper">
                <canvas id="explosion-canvas"></canvas>

                <div class="kitties-container" id="kitties">
                    <div class="kitty-card">
                        <span class="party-cap">🥳</span>
                        <span class="kitty-avatar">🐱</span>
                        <small style="color:#333; font-weight:bold;">Milo</small>
                    </div>
                    <div class="kitty-card">
                        <span class="party-cap">🎉</span>
                        <span class="kitty-avatar">😸</span>
                        <small style="color:#333; font-weight:bold;">Otis</small>
                    </div>
                </div>

                <svg class="svg-cake" id="cake-svg" viewBox="0 0 300 300">
                    <g class="cake-top">
                        <path class="candle-flame" d="M150,40 Q145,25 150,15 Q155,25 150,40 Z" fill="#ffea00" />
                        <path class="candle-flame" d="M150,35 Q147,28 150,20 Q153,28 150,35 Z" fill="#ff6d00" />
                        <rect x="146" y="40" width="8" height="35" rx="3" fill="#ff4081" />
                        <rect x="146" y="45" width="8" height="5" fill="#ffffff" opacity="0.6" />
                        <rect x="146" y="58" width="8" height="5" fill="#ffffff" opacity="0.6" />
                        
                        <path d="M70,130 C70,105 230,105 230,130 L230,165 C230,180 70,180 70,165 Z" fill="#ff80ab" />
                        <path d="M70,130 Q85,150 100,135 Q115,155 130,135 Q145,155 160,135 Q175,155 190,135 Q205,155 220,135 Q230,145 230,130 C230,105 70,105 70,130 Z" fill="#ffffff" />
                        <circle cx="100" cy="120" r="4" fill="#ffeb3b" />
                        <circle cx="140" cy="118" r="4" fill="#00e676" />
                        <circle cx="180" cy="122" r="4" fill="#00b0ff" />
                    </g>

                    <g class="cake-bottom">
                        <path d="M50,165 C50,140 250,140 250,165 L250,225 C250,250 50,250 50,225 Z" fill="#ba68c8" />
                        <path d="M50,165 Q70,185 90,170 Q110,190 130,170 Q150,190 170,170 Q190,190 210,170 Q230,190 250,165 C250,140 50,140 50,165 Z" fill="#f3e5f5" />
                        <ellipse cx="150" cy="235" rx="120" ry="18" fill="#e0e0e0" opacity="0.5" />
                    </g>
                </svg>
            </div>

            <button class="btn" id="cut-btn" onclick="cutCake()">Cut the Cake 🔪🎂</button>
        </div>
    </div>

    <script>
        // ================= BACKGROUND PARTICLES =================
        const particleContainer = document.getElementById('particle-container');
        const particlesArray = [];
        for (let i = 0; i < 50; i++) {
            let p = document.createElement('div');
            p.className = 'particle';
            let size = Math.random() * 8 + 4;
            p.style.width = `${size}px`;
            p.style.height = `${size}px`;
            p.style.left = `${Math.random() * 100}vw`;
            p.style.top = `${Math.random() * 100}vh`;
            p.style.animationDelay = `${Math.random() * 5}s`;
            let speed = (Math.random() * 0.6) - 0.3;
            particlesArray.push({ element: p, speed: speed });
            particleContainer.appendChild(p);
        }

        window.addEventListener('scroll', () => {
            let scrollY = window.scrollY;
            particlesArray.forEach(p => {
                p.element.style.transform = `translateY(${scrollY * p.speed}px)`;
            });
        });

        // ================= FLOATING BALLOONS DECORATION =================
        const bgDeco = document.getElementById('bg-decorations');
        const balloonEmojis = ['🎈', '✨', '⭐', '🎉', '🌟'];
        for (let i = 0; i < 15; i++) {
            let b = document.createElement('div');
            b.className = 'floating-balloon';
            b.innerText = balloonEmojis[Math.floor(Math.random() * balloonEmojis.length)];
            b.style.left = `${Math.random() * 95}vw`;
            b.style.animationDuration = `${6 + Math.random() * 6}s`;
            b.style.animationDelay = `${Math.random() * 5}s`;
            bgDeco.appendChild(b);
        }

        // ================= PAGE NAVIGATION =================
        function showPage(pageId) {
            document.getElementById('main-page').style.display = 'none';
            document.getElementById('gift-page').style.display = 'none';
            document.getElementById('cake-page').style.display = 'none';

            let target = document.getElementById(pageId);
            if (pageId === 'cake-page') {
                target.style.display = 'flex';
            } else {
                target.style.display = 'block';
            }
            window.scrollTo(0, 0);
        }

        // ================= GIFT BOXES & TEEN NOTES =================
        const teenNotes = [
            "Happy Birthday! May your Wi-Fi be strong and your phone battery never die today. 📱✨",
            "Welcome to another year of surviving school! You're doing amazing. Have a blast! 🎒🎉",
            "Another year older, but still not old enough to pay the bills! Enjoy the free ride. 💸😎",
            "Happy Birthday! Sleep in, eat junk food, and blame it on growing! 🍕💤",
            "May your skin stay clear and your vibes stay immaculate all year long. ✨💅",
            "Wishing you awesome music, great friends, and absolutely zero homework today! 🎧🚫📚",
            "Here is to being a teenager! You're officially at the age where you know everything. 🙌🧠",
            "Happy Birthday! Have a fantastic day, make crazy memories, and enjoy every second! 🎢😜"
        ];

        const giftContainer = document.getElementById('gifts-container');
        teenNotes.forEach((note) => {
            let box = document.createElement('div');
            box.className = 'gift-box';
            box.innerHTML = '🎁';
            box.onclick = () => openGift(box, note);
            giftContainer.appendChild(box);
        });

        function openGift(boxElement, noteMessage) {
            document.getElementById('note-text').innerText = noteMessage;
            document.getElementById('note-modal').style.display = 'block';
            document.getElementById('modal-bg').style.display = 'block';
            boxElement.classList.add('opened');
            boxElement.innerHTML = '🎉';
        }

        function closeNote() {
            document.getElementById('note-modal').style.display = 'none';
            document.getElementById('modal-bg').style.display = 'none';
        }

        // ================= CAKE CUTTING & EXPLOSION =================
        let cakeCut = false;
        function cutCake() {
            if (cakeCut) return;
            cakeCut = true;

            // Trigger Cake Explosion
            document.getElementById('cake-svg').classList.add('exploded');
            document.getElementById('kitties').classList.add('pop-out');
            document.getElementById('cake-title').innerText = "🎉 SURPRISE! 🎉";
            document.getElementById('cake-subtitle').innerText = "Milo & Otis popped out to wish you Happy Birthday!";
            document.getElementById('cut-btn').style.display = 'none';

            // Launch Confetti Particle Burst
            triggerCanvasExplosion();

            // Play Synth Birthday Audio
            playBirthdayMusic();
        }

        // Particle explosion on Canvas
        function triggerCanvasExplosion() {
            const canvas = document.getElementById('explosion-canvas');
            const ctx = canvas.getContext('2d');
            canvas.width = canvas.parentElement.clientWidth;
            canvas.height = canvas.parentElement.clientHeight;

            const particles = [];
            const colors = ['#ff4081', '#ffeb3b', '#00e676', '#00b0ff', '#e040fb'];

            for (let i = 0; i < 90; i++) {
                particles.push({
                    x: canvas.width / 2,
                    y: canvas.height / 2,
                    vx: (Math.random() - 0.5) * 14,
                    vy: (Math.random() - 0.5) * 14,
                    radius: Math.random() * 6 + 3,
                    color: colors[Math.floor(Math.random() * colors.length)],
                    alpha: 1
                });
            }

            function animateCanvas() {
                ctx.clearRect(0, 0, canvas.width, canvas.height);
                let alive = false;
                particles.forEach(p => {
                    p.x += p.vx;
                    p.y += p.vy;
                    p.vy += 0.15; // Gravity
                    p.alpha -= 0.012;

                    if (p.alpha > 0) {
                        alive = true;
                        ctx.save();
                        ctx.globalAlpha = p.alpha;
                        ctx.beginPath();
                        ctx.arc(p.x, p.y, p.radius, 0, Math.PI * 2);
                        ctx.fillStyle = p.color;
                        ctx.fill();
                        ctx.restore();
                    }
                });
                if (alive) requestAnimationFrame(animateCanvas);
            }
            animateCanvas();
        }

        // ================= WEB AUDIO SYNTHESIZER (BIRTHDAY SONG) =================
        function playBirthdayMusic() {
            const AudioContext = window.AudioContext || window.webkitAudioContext;
            if (!AudioContext) return;
            const ctx = new AudioContext();

            // Happy Birthday melody notes (frequency & duration)
            const notes = [
                { f: 264, d: 0.35 }, { f: 264, d: 0.35 }, { f: 297, d: 0.7 }, { f: 264, d: 0.7 }, { f: 352, d: 0.7 }, { f: 330, d: 1.2 },
                { f: 264, d: 0.35 }, { f: 264, d: 0.35 }, { f: 297, d: 0.7 }, { f: 264, d: 0.7 }, { f: 396, d: 0.7 }, { f: 352, d: 1.2 },
                { f: 264, d: 0.35 }, { f: 264, d: 0.35 }, { f: 528, d: 0.7 }, { f: 440, d: 0.7 }, { f: 352, d: 0.7 }, { f: 330, d: 0.7 }, { f: 297, d: 0.7 },
                { f: 466, d: 0.35 }, { f: 466, d: 0.35 }, { f: 440, d: 0.7 }, { f: 352, d: 0.7 }, { f: 396, d: 0.7 }, { f: 352, d: 1.4 }
            ];

            let time = ctx.currentTime + 0.1;
            notes.forEach(note => {
                const osc = ctx.createOscillator();
                const gain = ctx.createGain();

                osc.type = 'triangle'; // Warm festive tone
                osc.frequency.setValueAtTime(note.f, time);

                gain.gain.setValueAtTime(0.15, time);
                gain.gain.exponentialRampToValueAtTime(0.0001, time + note.d - 0.05);

                osc.connect(gain);
                gain.connect(ctx.destination);

                osc.start(time);
                osc.stop(time + note.d);

                time += note.d;
            });
        }
    </script>
</body>
</html>
